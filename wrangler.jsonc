{
  "name": "astro-gecko-welcome",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "astrogecko.com",
      "custom_domain": true,
      "zone_name": "astrogecko.com"
    },
    {
      "pattern": "www.astrogecko.com",
      "custom_domain": true,
      "zone_name": "astrogecko.com"
    }
  ]
}
